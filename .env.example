# Copy to .env (git-ignored) and fill in what you use. Variables already set in the
# environment win over this file. Leave out what you don't need.

# --- LLM: any OpenAI-compatible endpoint (the curator, Studio chat, `ictx ask`, `ictx pbi ask`)
# OpenAI:
API_KEY=
API_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-5-mini
# or OpenRouter: put your OpenRouter key in API_KEY and use
# API_BASE_URL=https://openrouter.ai/api/v1
# CHAT_MODEL=meta/muse-spark-1.3-contributor

# --- Databricks: captured Power BI metrics on a SQL warehouse (`ictx pbi query/ci/drift/serve`)
# Without these, Power BI metrics run on the local stand-in (the .pbix's own rows).
# DATABRICKS_SERVER_HOSTNAME=adb-1234567890123456.7.azuredatabricks.net
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse id>
# OAuth M2M as a service principal (preferred):
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
# or a personal access token (used only without client id and secret):
# DATABRICKS_TOKEN=

# --- GitLab: the Power BI models repo (`ictx pbi serve --gitlab`, the local demo script)
# GITLAB_TOKEN=            # read_api to serve releases; api to run scripts/demo_pbi_gitlab.py

# --- Metrics MCP server over HTTP (`ictx pbi serve --http`): pick API keys, OIDC, or both
# ICTX_PBI_KEYS=keys.yaml                                   # written with `ictx pbi serve keygen`
# ICTX_OIDC_ISSUER=https://login.microsoftonline.com/<tenant id>/v2.0
# ICTX_OIDC_AUDIENCE=api://pbi-metrics
# ICTX_AUDIT_LOG=audit.jsonl
# Over stdio the caller is the OS user, or:
# ICTX_PRINCIPAL=ana@client.com
# ICTX_GROUPS=Retail Ops

# --- Context Studio
# CTX_STUDIO_HOME=.studio   # where the Studio keeps its content repo, proposals and warehouses
