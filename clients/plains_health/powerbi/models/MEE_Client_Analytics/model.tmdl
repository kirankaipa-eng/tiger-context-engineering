model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Metrics","DiseaseCategory"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Metrics

ref table DiseaseCategory
