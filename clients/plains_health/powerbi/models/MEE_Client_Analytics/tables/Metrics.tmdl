	measure '5Yr Change' = VAR _y = MAX(Metrics[Year]) VAR _c = CALCULATE(SUM(Metrics[RiskScore]), ALLSELECTED(Metrics), Metrics[Year] = _y) VAR _b = CALCULATE(SUM(Metrics[RiskScore]), ALL(Metrics), Metrics[Year] = 2021) RETURN _c - _b
