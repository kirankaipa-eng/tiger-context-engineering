	measure 'Average Members' = VAR _y = MAX(Metrics[Year]) RETURN CALCULATE(SUM(Metrics[Members]), ALLSELECTED(Metrics), Metrics[Year] = _y)
		formatString: #,0
		lineageTag: cb1afe9a-8bba-53d0-b72e-9ea2b99d2ae5

	measure 'Members YoY' = VAR _y = MAX(Metrics[Year]) VAR _c = CALCULATE(SUM(Metrics[Members]), ALL(Metrics), Metrics[Year] = _y) VAR _p = CALCULATE(SUM(Metrics[Members]), ALL(Metrics), Metrics[Year] = _y - 1) VAR _d = DIVIDE(_c - _p, _p) RETURN IF(ISBLANK(_p), "--", IF(_d < 0, "▼ ", "▲ ") & FORMAT(ABS(_d), "0.0%") & " YoY")
		lineageTag: 03b05468-12bd-57cb-a1d1-a19dd6c6f1e7

	measure '% Female' = VAR _y = MAX(Metrics[Year]) RETURN CALCULATE(SUM(Metrics[PctFemale]), ALLSELECTED(Metrics), Metrics[Year] = _y)
